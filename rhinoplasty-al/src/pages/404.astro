---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
import { locales, site } from '../site.config';
import { localeHomePath } from '../lib/pages';

const switcher = locales.map((l) => ({ locale: l, href: localeHomePath(l) }));
---

<Base
  locale="en"
  title={t('en', 'notFound.title')}
  description={t('en', 'notFound.body')}
  canonical={`${site.url}/404/`}
  alternates={[]}
  switcher={switcher}
  indexable={false}
>
  <div class="wrap page">
    <h1>{t('en', 'notFound.title')}</h1>
    {
      locales.map((l) => (
        <section lang={l}>
          <p>{t(l, 'notFound.body')}</p>
          <p><a href={localeHomePath(l)}>{t(l, 'notFound.home')}</a></p>
        </section>
      ))
    }
  </div>
</Base>
