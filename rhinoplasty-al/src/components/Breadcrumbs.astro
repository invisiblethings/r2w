---
import { t } from '../i18n/ui';
import type { Locale } from '../site.config';

interface Props {
  locale: Locale;
  items: { name: string; href: string }[];
  current: string;
}

const { locale, items, current } = Astro.props;
---

<nav class="breadcrumbs" aria-label={t(locale, 'nav.breadcrumb')}>
  <ol>
    {items.map((item) => <li><a href={item.href}>{item.name}</a></li>)}
    <li aria-current="page">{current}</li>
  </ol>
</nav>
