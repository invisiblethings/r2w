---
import Icon from './Icon.astro';
import { globalNav, t, type UiKey } from '../i18n/ui';
import { sectionIcon } from '../lib/icons';
import { find, pathOf, type Page } from '../lib/pages';
import type { Locale } from '../site.config';

interface Props {
  locale: Locale;
  pages: Page[];
  items: Page[];
  /** Heading for the list; omitted on a hub, where the list is the page's own content. */
  heading?: string;
  currentKey: string;
}

const { locale, pages, items, heading, currentKey } = Astro.props;
const others = globalNav
  .filter((k) => k !== currentKey)
  .map((k) => ({ key: k, page: find(pages, k, locale), label: t(locale, `nav.${k}` as UiKey) }))
  .filter((o) => o.page);
---

{
  items.length > 0 ? (
    <section class="section-list" aria-labelledby={heading ? 'section-list-title' : undefined}>
      {heading && <h2 id="section-list-title">{heading}</h2>}
      <ul class="cards">
        {items.map((p) => (
          <li class="card">
            <h3><a class="stretched" href={pathOf(p.data.slug)}>{p.data.h1 ?? p.data.title}</a></h3>
            <p>{p.data.description}</p>
            <span class="card-more">{t(locale, 'card.read')} <Icon name="arrow-right" size={16} /></span>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    !heading && currentKey !== 'clinics' && (
      <section class="empty-state">
        <p>{t(locale, 'hub.empty')}</p>
        <h2>{t(locale, 'hub.elsewhere')}</h2>
        <ul class="pill-links">
          {others.map((o) => (
            <li>
              <a href={pathOf(o.page!.data.slug)}>
                <Icon name={sectionIcon[o.key] ?? 'layers'} size={18} />
                {o.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  )
}
