---
import { t } from '../i18n/ui';
import type { Locale } from '../site.config';

interface Props {
  locale: Locale;
  items: { q: string; a: string }[];
}

const { locale, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">{t(locale, 'faq.title')}</h2>
      {items.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </section>
  )
}
