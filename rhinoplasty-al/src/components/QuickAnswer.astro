---
import { t } from '../i18n/ui';
import type { Locale } from '../site.config';

interface Props {
  locale: Locale;
  text: string;
}

const { locale, text } = Astro.props;
---

<aside class="quick-answer" aria-labelledby="quick-answer-label">
  <p class="quick-answer-label" id="quick-answer-label">{t(locale, 'quick.label')}</p>
  <p>{text}</p>
</aside>
